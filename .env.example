# Postgres (z.b. Neon über den Vercel Marketplace)
DATABASE_URL=

# Login (Better Auth + GitHub)
BETTER_AUTH_SECRET=          # zufällig, z.b. `openssl rand -base64 32`
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_LOGINS=a2hengk # wer rein darf, kommagetrennt
# BETTER_AUTH_URL=           # nur nötig bei eigener Domain, sonst automatisch

# Nur lokal: Login überspringen (wirkt nur mit `npm run dev`)
# DEV_SKIP_AUTH=1

# Schützt /api/cron/reminders – der externe Cron schickt das als Bearer-Token
CRON_SECRET=

# Mail-Reminder über Resend
RESEND_API_KEY=
REMINDER_MAIL_TO=

# Cloudflare R2 für die Schul-Ablage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: KI-Funktionen über die Claude API
ANTHROPIC_API_KEY=
